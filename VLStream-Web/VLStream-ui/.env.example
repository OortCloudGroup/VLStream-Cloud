# VLStream backend used by the existing application
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080

# Independent WVP backend used by ISUP / RTSP / ONVIF / GB28181 / Dahua pages
VITE_WVP_PROXY_TARGET=http://127.0.0.1:9080

# Optional. Leave empty to use /wvp-api in development and /bus/wvp-server in production.
VITE_WVP_API_BASE_URL=

# Optional CameraRTC settings. Additional TURN URLs reuse the credentials
# returned by the same CameraRTC signaling service; separate multiple URLs with commas.
VITE_CAMERA_RTC_PROXY_TARGET=http://146.56.220.167:8082
VITE_CAMERA_RTC_TURN_URLS=

# Unified platform login and gateway identity used when the backend tenant mode is multi.
VITE_PLATFORM_LOGIN_URL=https://workup.oortcloudsmart.com:2443/bus/apaas-web/loginPage/index.html
VITE_PLATFORM_APP_NAME=VLStream
VITE_PLATFORM_REQUEST_TYPE=app
VITE_PLATFORM_APP_ID=replace-with-platform-app-id
VITE_PLATFORM_SECRET_KEY=replace-with-platform-secret-key
