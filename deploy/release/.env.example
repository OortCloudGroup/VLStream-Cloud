TZ=Asia/Shanghai
HTTP_PORT=80
BACKEND_PORT=8080

BACKEND_IMAGE=ghcr.io/oortcloudgroup/vlstream-backend:1.2.5
FRONTEND_IMAGE=ghcr.io/oortcloudgroup/vlstream-frontend:1.2.5

# VLStream WVP Lite v1.0.6 must be deployed first. It is published as
# ghcr.io/oortcloudgroup/vlstream-cloud-lite:1.0.6. Use WVP_HTTP_PORT=9080 in its .env when
# both products run on the same host because VLStream uses host port 8080.
VLSTREAM_WVP_INTERNAL_BASE_URL=http://host.docker.internal:9080
VLSTREAM_WVP_DEVICE_BASE_URL=http://host.docker.internal:9080
WVP_UPSTREAM=http://host.docker.internal:9080

# Optional platform message service used for workflow notifications.
UNIFIEDMESSAGINGSEND_URL=

# XXL-Job is disabled by default, but its client still needs a syntactically
# valid admin address at Spring startup.
XXL_JOB_ADMIN_ADDRESSES=http://host.docker.internal:9100/xxl-job-admin
AUTH_REPORT_EXCLUDE_CLASSES=ReModeJsonController,ProcessTemplateController,WfTXController

# Reuse the ZLMediaKit service started by the VLStream WVP Lite v1.0.6 deployment.
VLSTREAM_ZLM_INTERNAL_URL=http://host.docker.internal:8081
ZLM_UPSTREAM=http://host.docker.internal:8081
ZLMEDIAKIT_SECRET=change-me-zlmediakit-secret

# Required for device event-media uploads. The config key must name an enabled
# sys_oss_config record that points to an endpoint reachable by the device.
VLSTREAM_DEVICE_MEDIA_OSS_CONFIG_KEY=minio-device-media
VLSTREAM_DEVICE_MEDIA_ALLOW_UNAUTHENTICATED=false

# Leave blank when MQTT is not deployed. Do not store a production broker
# password in this file.
VLSTREAM_MQTT_HOST=
VLSTREAM_MQTT_PORT=1883
VLSTREAM_MQTT_USERNAME=
VLSTREAM_MQTT_PASSWORD=

MYSQL_PORT=3306
MYSQL_HOST=mysql.example.internal
MYSQL_DATABASE=oortcloud_workflowforms_vls
MYSQL_USER=vlstream
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

REDIS_PORT=6379
REDIS_HOST=redis.example.internal
REDIS_PASSWORD=change-me

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=vlstream
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=vlstream

WEBRTC_PORT=8000
WEBRTC_EXTERNAL_HOST=host.docker.internal
WEBRTC_STREAMER_IMAGE=mpromonet/webrtc-streamer:v0.8.16

# Optional IPC remote-management profile. Keep disabled until wildcard DNS/TLS,
# the three independent secrets, and the rathole Noise keypair are configured.
VLSTREAM_TUNNEL_ENABLED=false
TUNNEL_RUNTIME_IMAGE=vlstream/tunnel-runtime:local
VLSTREAM_TUNNEL_REMOTE_ADDRESS=tunnel.example.com:2333
VLSTREAM_TUNNEL_CONTROL_PORT=2333
VLSTREAM_TUNNEL_GATEWAY_PORT=8088
VLSTREAM_TUNNEL_GATEWAY_HOST_SUFFIX=.ipc.example.com
VLSTREAM_TUNNEL_GATEWAY_BASE_URL=https://{sessionId}.ipc.example.com
VLSTREAM_TUNNEL_ACCESS_SESSION_TTL_SECONDS=36000
VLSTREAM_TUNNEL_NOISE_REMOTE_PUBLIC_KEY=replace-with-rathole-noise-public-key
VLSTREAM_TUNNEL_NOISE_PRIVATE_KEY=replace-with-rathole-noise-private-key
VLSTREAM_TUNNEL_SERVICE_SIGNING_SECRET=change-me-tunnel-service-secret
VLSTREAM_TUNNEL_CONTROL_API_TOKEN=change-me-tunnel-control-token
VLSTREAM_TUNNEL_GATEWAY_API_TOKEN=change-me-tunnel-gateway-token

JAVA_OPTS=-Xms512m -Xmx2048m -Dfile.encoding=UTF-8
