# The bundled Compose file has local defaults. Copy this file to .env and
# replace every change-me value before production use.
TZ=Asia/Shanghai
HTTP_PORT=80
BACKEND_PORT=8080
WVP_BACKEND_PORT=9080
WVP_SIP_PORT=8116
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
WEBRTC_PORT=8000
WEBRTC_RTP_START_PORT=50000
WEBRTC_RTP_END_PORT=50010
ZLMEDIAKIT_HTTP_PORT=8090
ZLMEDIAKIT_RTSP_PORT=554
ZLMEDIAKIT_RTMP_PORT=1935
ZLMEDIAKIT_RTC_PORT=8000
ZLMEDIAKIT_RTP_START_PORT=40000
ZLMEDIAKIT_RTP_END_PORT=40300

MYSQL_DATABASE=oortcloud_workflowforms_vls
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=vlstream
MYSQL_PASSWORD=change-me-db
WVP_MYSQL_DATABASE=ry-wvp
WVP_MYSQL_USER=wvp
WVP_MYSQL_PASSWORD=change-me-wvp-db
WVP_REDIS_DATABASE=10
REDIS_PASSWORD=change-me-redis
MINIO_ROOT_USER=vlstream
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=vlstream

# WebRTC-streamer v0.8.16 publishes UDP ports 50000-50010.
# For access from another computer, set this to the Docker host's reachable
# LAN address, public address, or resolvable hostname and open that UDP range.
WEBRTC_STREAMER_IMAGE=mpromonet/webrtc-streamer:v0.8.16
WEBRTC_EXTERNAL_HOST=host.docker.internal

# WVP and ZLMediaKit. For device access from another computer, replace both
# addresses with the Docker host's reachable LAN/public IP and open SIP, RTP,
# RTSP, RTMP, and WebRTC ports in the host and cloud firewall.
WVP_BACKEND_IMAGE=ghcr.io/oortcloudgroup/vlstream-wvp-backend:1.2.0
ZLMEDIAKIT_IMAGE=zlmediakit/zlmediakit@sha256:2c03e739e5461f32fe6609d8ae3c77c15d02815e01e09b02d580b3eb10e804fc
ZLMEDIAKIT_PUBLIC_HOST=127.0.0.1
SIP_PUBLIC_IP=127.0.0.1
ZLMEDIAKIT_SECRET=change-me-zlmediakit-secret
WVP_TOKEN_SECRET=change-me-wvp-token-secret
VLSTREAM_DEFAULT_DEPT_ID=

# Optional private integrations. Leave blank for a standalone deployment.
XXL_JOB_ADMIN_ADDRESSES=
UNIFIEDMESSAGINGSEND_URL=

# Required by compose.external.yaml.
EXTERNAL_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/oortcloud_workflowforms_vls?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
EXTERNAL_MYSQL_USERNAME=vlstream
EXTERNAL_MYSQL_PASSWORD=change-me
EXTERNAL_WVP_MYSQL_HOST=127.0.0.1
EXTERNAL_WVP_MYSQL_PORT=3306
EXTERNAL_WVP_MYSQL_DATABASE=ry-wvp
EXTERNAL_WVP_MYSQL_USERNAME=wvp
EXTERNAL_WVP_MYSQL_PASSWORD=change-me
EXTERNAL_REDIS_HOST=127.0.0.1
EXTERNAL_REDIS_PORT=6379
EXTERNAL_REDIS_PASSWORD=change-me
