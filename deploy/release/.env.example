TZ=Asia/Shanghai
HTTP_PORT=80
BACKEND_PORT=8080

BACKEND_IMAGE=ghcr.io/oortcloudgroup/vlstream-backend:1.2.1
FRONTEND_IMAGE=ghcr.io/oortcloudgroup/vlstream-frontend:1.2.1

# WVP v1.0.1 must be deployed first. Use WVP_HTTP_PORT=9080 in its .env when
# both products run on the same host because VLStream uses host port 8080.
VLSTREAM_WVP_INTERNAL_BASE_URL=http://host.docker.internal:9080
WVP_UPSTREAM=http://host.docker.internal:9080

# Reuse the ZLMediaKit service started by the WVP v1.0.1 deployment.
VLSTREAM_ZLM_INTERNAL_URL=http://host.docker.internal:8081
ZLM_UPSTREAM=http://host.docker.internal:8081
ZLMEDIAKIT_SECRET=change-me-zlmediakit-secret

MYSQL_PORT=3306
MYSQL_HOST=mysql.example.internal
MYSQL_DATABASE=oortcloud_workflowforms_vls
MYSQL_USER=vlstream
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

REDIS_PORT=6379
REDIS_HOST=redis.example.internal
REDIS_PASSWORD=change-me

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=vlstream
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=vlstream

WEBRTC_PORT=8000
WEBRTC_EXTERNAL_HOST=host.docker.internal
WEBRTC_STREAMER_IMAGE=mpromonet/webrtc-streamer:v0.8.16

JAVA_OPTS=-Xms512m -Xmx2048m -Dfile.encoding=UTF-8
