TZ=Asia/Shanghai
HTTP_PORT=80
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod

BACKEND_IMAGE=ghcr.io/oortcloudgroup/vlstream-backend:1.2.6
FRONTEND_IMAGE=ghcr.io/oortcloudgroup/vlstream-frontend:1.2.6

# Deploy VLStream WVP Lite v1.0.8 first: https://github.com/OortCloudGroup/VLStream-Cloud-Lite/releases/tag/v1.0.8
# These addresses are resolved from the VLStream backend/frontend containers.
VLSTREAM_WVP_INTERNAL_BASE_URL=http://host.docker.internal:9080
VLSTREAM_WVP_DEVICE_BASE_URL=http://host.docker.internal:9080
WVP_UPSTREAM=http://host.docker.internal:9080
VLSTREAM_ZLM_INTERNAL_URL=http://host.docker.internal:8081
VLSTREAM_ZLM_PUBLIC_URL=/bus/zlm-server
ZLM_UPSTREAM=http://host.docker.internal:8081
ZLMEDIAKIT_SECRET=change-me-zlm-secret
VLSTREAM_MQTT_HOST=
VLSTREAM_MQTT_PORT=1883
VLSTREAM_MQTT_USERNAME=
VLSTREAM_MQTT_PASSWORD=
VLSTREAM_SSH_HOST=
VLSTREAM_SSH_PORT=22
VLSTREAM_SSH_USERNAME=
VLSTREAM_SSH_PASSWORD=
VLSTREAM_MODEL_PUBLIC_BASE_URL=
VLSTREAM_FIRMWARE_PLATFORM_BASE_URL=
UNIFIEDMESSAGINGSEND_URL=

MYSQL_PORT=3306
MYSQL_HOST=mysql.example.internal
MYSQL_DATABASE=oortcloud_workflowforms_vls
MYSQL_USER=vlstream
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
WVP_MYSQL_DATABASE=ry-wvp
WVP_MYSQL_USER=wvp
WVP_MYSQL_PASSWORD=change-me-wvp-db-password

REDIS_PORT=6379
REDIS_HOST=redis.example.internal
REDIS_PASSWORD=change-me

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=vlstream
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=vlstream

WEBRTC_PORT=8000
WEBRTC_EXTERNAL_HOST=host.docker.internal
WEBRTC_STREAMER_IMAGE=mpromonet/webrtc-streamer:v0.8.16
VLSTREAM_DEVICE_MEDIA_ALLOW_UNAUTHENTICATED=false
VLSTREAM_DEVICE_MEDIA_OSS_CONFIG_KEY=minio-device-media

# IPC control plane is enabled by default. The tunnel sidecar profile stays off
# until wildcard DNS/TLS, independent secrets, and the Noise keypair are configured.
VLSTREAM_TUNNEL_ENABLED=true
TUNNEL_RUNTIME_IMAGE=vlstream/tunnel-runtime:local
VLSTREAM_TUNNEL_REMOTE_ADDRESS=tunnel.example.com:2333
VLSTREAM_TUNNEL_CONTROL_PORT=2333
VLSTREAM_TUNNEL_GATEWAY_PORT=8088
VLSTREAM_TUNNEL_GATEWAY_HOST_SUFFIX=.ipc.example.com
VLSTREAM_TUNNEL_GATEWAY_BASE_URL=https://{sessionId}.ipc.example.com
VLSTREAM_TUNNEL_ACCESS_SESSION_TTL_SECONDS=36000
VLSTREAM_TUNNEL_ENROLLMENT_TTL_SECONDS=36000
VLSTREAM_TUNNEL_NOISE_REMOTE_PUBLIC_KEY=replace-with-rathole-noise-public-key
VLSTREAM_TUNNEL_NOISE_PRIVATE_KEY=replace-with-rathole-noise-private-key
VLSTREAM_TUNNEL_SERVICE_SIGNING_SECRET=replace-with-at-least-32-random-characters
VLSTREAM_TUNNEL_CONTROL_API_TOKEN=replace-with-a-different-32-character-token
VLSTREAM_TUNNEL_GATEWAY_API_TOKEN=replace-with-another-32-character-token

JAVA_OPTS=-Xms512m -Xmx2048m -Dfile.encoding=UTF-8
