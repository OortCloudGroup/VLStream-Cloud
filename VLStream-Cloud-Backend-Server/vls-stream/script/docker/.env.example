# Copy this file to .env before starting Docker Compose.
# Do not commit the resulting .env file.

EMQX_IMAGE=192.168.88.150:80/opensource/emqx/emqx:5.4

# Use long random values. Avoid spaces and # in this local test file.
EMQX_NODE_COOKIE=replace-with-a-long-random-node-cookie
EMQX_DASHBOARD_PASSWORD=replace-with-a-strong-dashboard-password

# Shared only by the local backend and hardware test clients.
# Production devices must use independent credentials and Topic ACLs.
VLSTREAM_MQTT_USERNAME=vlstream-local
VLSTREAM_MQTT_PASSWORD=replace-with-a-strong-mqtt-password

# Hardware event images. Use an enabled private sys_oss_config entry in production.
VLSTREAM_DEVICE_MEDIA_OSS_CONFIG_KEY=vlstream-events
VLSTREAM_DEVICE_MEDIA_UPLOAD_TTL_SECONDS=600
VLSTREAM_DEVICE_MEDIA_MAX_IMAGE_BYTES=10485760
VLSTREAM_DEVICE_MEDIA_ALLOW_UNAUTHENTICATED=false
